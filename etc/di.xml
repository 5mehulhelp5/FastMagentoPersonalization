<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Register the personalisation section into core's fastmagento:doctor. -->
    <type name="ParkkTech\FastMagento\Model\Doctor\Diagnostics">
        <arguments>
            <argument name="checkProviders" xsi:type="array">
                <item name="personalization" xsi:type="object">ParkkTech\FastMagentoPersonalization\Model\Doctor\PersonalizationCheckProvider</item>
            </argument>
        </arguments>
    </type>
    <!-- Diagnostics constructs the provider above, so the provider must not construct Diagnostics
         eagerly: a Proxy breaks the cycle and resolves on first use. -->
    <type name="ParkkTech\FastMagentoPersonalization\Model\Doctor\PersonalizationCheckProvider">
        <arguments>
            <argument name="diagnostics" xsi:type="object">ParkkTech\FastMagento\Model\Doctor\Diagnostics\Proxy</argument>
        </arguments>
    </type>
    <!-- Personalise the display order of Related / Up-sell / Cross-sell rows (re-order only). -->
    <type name="ParkkTech\FastMagento\Plugin\LinkProductCollectionPlugin">
        <plugin name="parkktech_fastmagento_personalization_link_reorder"
                type="ParkkTech\FastMagentoPersonalization\Plugin\LinkProductCollectionPersonalizePlugin"
                sortOrder="10"/>
    </type>
    <!-- Search-stack seams: replace core's no-op defaults with the real implementations. -->
    <preference for="ParkkTech\FastMagento\Model\Search\QueryDecoratorInterface"
                type="ParkkTech\FastMagentoPersonalization\Model\Search\QueryPersonalizerDecorator"/>
    <preference for="ParkkTech\FastMagento\Model\Search\ExplorationWindowInterface"
                type="ParkkTech\FastMagentoPersonalization\Model\Search\ExplorationSlotWindow"/>
    <preference for="ParkkTech\FastMagento\Model\Analytics\EventRecorderInterface"
                type="ParkkTech\FastMagentoPersonalization\Model\Analytics\EventCollectorRecorder"/>
    <!-- GraphQL authenticates by token, not session, so the storefront's pre-dispatch capture finds
         nobody. Same request-scoped holder, so personalisation means one thing on both. -->
    <type name="Magento\GraphQl\Model\Query\ContextFactory">
        <plugin name="parkktech_fastmagento_personalization_graphql_context"
                type="ParkkTech\FastMagentoPersonalization\Plugin\GraphQl\PersonalizationContextPlugin"
                sortOrder="100"/>
    </type>
    <!-- Personalisation CLI: profiles, exposure, discrimination, the weight dial and explain. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="fastmagento_profile_inspect" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\ProfileInspect</item>
                <item name="fastmagento_profile_backfill" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\ProfileBackfill</item>
                <item name="fastmagento_personalization_discrimination" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\DiscriminationBuild</item>
                <item name="fastmagento_personalization_exposure" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\ExposureBuild</item>
                <item name="fastmagento_personalization_tune" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\TuneWeight</item>
                <item name="fastmagento_personalization_explain" xsi:type="object">ParkkTech\FastMagentoPersonalization\Console\Command\PersonalizationExplain</item>
            </argument>
        </arguments>
    </type>
</config>
